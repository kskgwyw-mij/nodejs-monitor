# Copy to .env and adjust. Never commit .env.
NODE_ENV=production

# Interface/port to listen on. Keep 127.0.0.1 behind a reverse proxy.
HOST=127.0.0.1
PORT=3000

# REQUIRED in production: at least 32 random characters.
# Generate one with:  node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# For rotation, put the new secret first and the old one(s) after, comma-separated.
SESSION_SECRET=

# SQLite database file (directory is created with 0700 permissions).
DATABASE_PATH=./data/app.db

# Set when running behind a reverse proxy that terminates TLS
# (number of proxy hops, e.g. 1, or "loopback"). Leave empty when exposed directly.
TRUST_PROXY=

# Optional: serve HTTPS directly from Node instead of via a proxy.
# TLS_CERT_FILE=./certs/fullchain.pem
# TLS_KEY_FILE=./certs/privkey.pem

# ---- Map ----
# Overpass API endpoint(s) for OpenStreetMap data; comma-separated list = failover order.
# Public instances: https://wiki.openstreetmap.org/wiki/Overpass_API#Public_Overpass_API_instances
# OVERPASS_URLS=https://overpass-api.de/api/interpreter
# Identify your site to Overpass (please include a contact URL or e-mail).
# OVERPASS_USER_AGENT=MySite/1.0 (+https://example.com/contact)
# Initial map view: "lat,lon,zoom" (default: Brandenburg Gate, Berlin).
# MAP_DEFAULT_VIEW=52.5163,13.3777,16
# Tile server (must contain {z}/{x}/{y}). Respect the provider's usage policy.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
