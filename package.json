{
  "name": "nodejs-monitor",
  "version": "1.0.0",
  "description": "A small, security-hardened Node.js website (Express 5, Node.js 25).",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=25.0.0 <26",
    "npm": ">=11.6.2",
    "yarn": ">=1.22.22 <2"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "node --permission --allow-net --allow-fs-read=./ --allow-fs-write=./data --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "audit": "npm audit --omit=dev && yarn audit --groups dependencies"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "leaflet": "1.9.4"
  }
}
